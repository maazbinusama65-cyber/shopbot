# --- Agent API (backend) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME          # your GROUP key; never commit it
MODEL=claude-haiku-5-5
# Supabase/Neon Postgres connection string (use the pooled URL). Leave unset for local SQLite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
ADMIN_TOKEN=choose-a-long-random-string       # seller dashboard password
CORS_ORIGINS=https://your-site.vercel.app,http://localhost:3000
